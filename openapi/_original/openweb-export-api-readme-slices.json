 {
  "page": "https://developers.openweb.com/reference/post_v2-export-comments.md",
  "definition": {
   "openapi": "3.0.0",
   "info": {
    "title": "Export API",
    "version": "1.0"
   },
   "servers": [
    {
     "url": "https://api-exporter.openweb.com"
    }
   ],
   "paths": {
    "/v2/export/comments": {
     "post": {
      "summary": "Request export",
      "responses": {
       "200": {
        "$ref": "#/components/responses/PostExportResponse"
       }
      },
      "parameters": [
       {
        "$ref": "#/components/parameters/apikey"
       }
      ],
      "requestBody": {
       "$ref": "#/components/requestBodies/PostExportCommentsRequest"
      },
      "tags": [
       "v2"
      ]
     }
    }
   },
   "components": {
    "parameters": {
     "apikey": {
      "name": "apikey",
      "in": "header",
      "required": true,
      "schema": {
       "type": "string"
      },
      "description": "Unique OpenWeb export token<br /><br />Follow these steps to obtain the export token:<ol><li>From your OpenWeb Admin Dashboard, click <strong>Settings</strong>.</li><li>Under <strong>Authentication Tokens</strong>, click <strong>ApiKey</strong>.</li><li>Copy the key.</li></ol>"
     }
    },
    "requestBodies": {
     "PostExportCommentsRequest": {
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "x-examples": {
          "Example 1": {
           "since": "2022-07-30T00:00:00Z",
           "to": "2022-07-30T23:59:00Z"
          }
         },
         "required": [
          "since",
          "to"
         ],
         "properties": {
          "since": {
           "type": "string",
           "description": "Start date of the export date range in `YYYY-MM-DDTHH:MM:SSZ` <a href=\"https://www.ietf.org/rfc/rfc3339.txt\" target=\"_blank\">RFC3339</a> format",
           "example": "2018-12-01T00:00:00Z"
          },
          "to": {
           "type": "string",
           "example": "2018-12-02T00:00:00Z",
           "description": "End date of the export date range in `YYYY-MM-DDTHH:MM:SSZ` <a href=\"https://www.ietf.org/rfc/rfc3339.txt\" target=\"_blank\">RFC3339</a> format\n\nIf not set, the default value is the current date and time."
          }
         }
        }
       }
      }
     }
    },
    "responses": {
     "PostExportResponse": {
      "description": "Example response",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "x-examples": {
          "Example 1": {
           "status_link": "STATUS_LINK",
           "status": "pending",
           "request_id": "REQUEST_ID"
          }
         },
         "properties": {
          "request_id": {
           "type": "string",
           "description": "Unique ID of the export request"
          },
          "status": {
           "description": "State of the export request",
           "type": "string",
           "enum": [
            "pending"
           ]
          },
          "status_link": {
           "type": "string",
           "description": "Check status endpoint"
          }
         }
        },
        "examples": {
         "Example 1": {
          "value": {
           "request_id": "REQUEST_ID",
           "status": "pending",
           "status_link": "STATUS_LINK"
          }
         }
        }
       }
      }
     }
    }
   },
   "x-readme": {
    "explorer-enabled": true,
    "proxy-enabled": true
   }
  }
 },
